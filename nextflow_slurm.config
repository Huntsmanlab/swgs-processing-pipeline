/*
 * The following pipeline parameters specify the default params and reference genome.
 */
params {
    // Single or paired-end reads? (Default: Paired-End, if false then single-ended data expected)
    pairedend = true

    // Trim reads to 50bp
    crop50 = false

    // Azure Data
    from_azure = false
    // Path to csv file with the columns: `sample_id`, `az_url`.
    // `sample_id` - intended sample ID.
    // `az_url`    - is a URL to the directory containing the sample's fastq files.
    az_csv = "$baseDir/path/to/csv"

    // Local Data
    use_csv = true
    // Path to a csv file with the columns: `sample_id`, `read1`, `read2` for paired-end, `sample_id`, `read` for single-end.
    // `sample_id` - intended sample ID.
    // `read/read1/read2`  - full path to a FASTQ file. For paired-end, `read1` should be forward and `read2` should be reverse.
    samples_csv = "$baseDir/path/to/csv"
    // glob pattern for local FASTQ files (e.g. '/path/to/reads/**.{fastq,fq,fastq.gz,fq.gz}')
    reads = "$baseDir/path/to/reads/*"
    // A regex pattern passed to replaceAll(<regex>, ''). Extracts everything minus the pattern and extensions as the sample ID.
    rm_regex = "(_1_|_2_).*"

    // Choose the reference genome
    genome = "hg19"
    // Path to ref genome and indexed results
    ref_path = "/path/to/reference"

    // Define the binsizes for copy-number calling
    binsizes = [30, 50]

    // QDNAseq PARAMS
    runqdnaseq = true
    // Path to directory containing QDNAseq bin annotatons, must only contain annotations for the desired genome build and read length.
    binannos = "$baseDir/path/to/biannos"
    // Create and use new bin annotations?
    qd_new_annot = false
    // bam files for normal samples
    qd_nbams = "$baseDir/path/to/bams"
    // mappability tracks (bigWig)
    qd_mappability = "$baseDir/path/to/mappability"
    // problematic regions blacklist (bed)
    qd_blacklist = "$baseDir/path/to/blacklist"
    // bigWigAverageOverBed binary
    qd_bwgavgbed = "$baseDir/path/to/bigWigAverageBed"
    
    // WX PARAMS
    runwisex = false
    // Existing references
    wx_refs = "$baseDir/test_data/ref/npz/refs"
    // Create new references?
    wx_newref = false
    // npz files for normal samples
    wx_normals = "$baseDir/test_data/ref/npz/normals"
    // Create new references from BAMs?
    wx_newref_frombam = false
    // bam files for normal samples
    wx_nbams = "$baseDir/test_data/ref/bams"
    
    // ichor PARAMS
    runichor = true
    // initial tumor ploidy
    ichor_ploidy = "c(2, 3, 4, 5)"
    // initial normal proportion
    ichor_normal = "c(0.5, 0.6, 0.7, 0.8, 0.9)"
    // max allowable CN state
    ichor_maxCN = 5
    
    outdir = "$baseDir/results"
    indir = "$baseDir/input"
    // Only bwamem2 is supported at the moment.
    aligner = 'bwamem2'

    multiqc_config = "$baseDir/multiqc_config.yaml"
}

process {
    executor = 'slurm'
    queue = 'upgrade'

    withName: AZURE_DOWNLOAD {
        container = 'huntsmanlab/azure_download:latest'
        cpus = 1
        memory = '8 GB'
        time = '2h'
    }
    withName: DOWNLOAD_HG38 {
        container = 'docker://curlimages/curl:latest'
        shell = ['/bin/sh']
        cpus = 1
        memory = '8 GB'
        time = '1h'
    }
    withName: 'FASTQC.*' {
        container = 'docker://staphb/fastqc:latest'
        cpus = 1
        memory = '8 GB'
        time = '4h'
    }
    withName: 'MULTIQC.*' {
        container = 'docker://quay.io/biocontainers/multiqc:1.3--py35_2'
        cpus = 1
        memory = '8 GB'
        time = '1h'
    }
    withName: 'TRIMMOMATIC.*' {
        container = 'docker://staphb/trimmomatic:latest'
        cpus = 8
        memory = '32 GB'
        time = '10h'
    }
    withName: '.*BWA.*' {
        container = 'docker://clinicalgenomics/bwa-mem2:2.2.1'
        cpus = 16
        memory = '40 GB'
        time = '18h'
    }
    withName: MINIMAP2_ALIGNMENT {
        container = 'docker://niemasd/minimap2_samtools:latest'
        cpus = 32
        memory = '128 GB'
        time = '12h'
    }
    withName: 'SORT_INDEX.*' {
        container = 'docker://staphb/samtools:1.19'
        cpus = 8
        memory = '32 GB'
        time = '16h'
    }
    withName: 'MARKDUP.*' {
        container = 'docker://broadinstitute/picard:latest'
        cpus = 1
        memory = '16 GB'
        time = '12h'
    }
    withName: 'INDCOVFLAG.*' {
        container = 'docker://staphb/samtools:1.19'
        cpus = 8
        memory = '16 GB'
        time = '12h'
    }
    withName: CN_QDNA1 {
        container = 'docker://huntsmanlab/qdnaseq:latest'
        cpus = 16
        memory = '32 GB'
        time = '12h'
    }
    withName: '.*WX.*' {
        container = 'docker://sofvdvel/wisecondorx:0.1'
        cpus = 16
        memory = '32 GB'
        time = '12h'
    }
    withName: 'RCN_TO_ACN.*' {
        container = 'docker://huntsmanlab/utanos:latest'
        cpus = 8
        memory = '16 GB'
        time = '12h'
    }
    withName: QDNA_BINS {
        container = 'docker://huntsmanlab/qdnaseq:latest'
        cpus = 8
        memory = '16 GB'
        time = '16h'
    }
    withName: ICHOR_CNA {
	container = 'docker://huntsmanlab/ichorcna:latest'
        cpus = 8
        memory = '16 GB'
        time = '20h'
    }
    withName: PROCESS_ICHOR {
	container = 'docker://huntsmanlab/utanos:latest'
	cpus = 1
	memory = '8 GB'
	time = '2h'
    }
}

singularity {
    enabled = true
    autoMounts = true
    // ensure that no user libraries get mounted into the container
    process.containerOptions = "--no-home"
}
