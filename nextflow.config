/*
 * The following pipeline parameters specify the default params and reference genome.
 */
params {
    // Single or paired-end reads? (Default: Paired-End, if false then single-ended data expected)
    pairedend = true

    // Provide the input file path (fastqs)
    reads = "$baseDir/test_data/paired/**.{fastq,fq,fastq.gz,fq.gz}"

    // Choose the reference genome
    genome = "hg19"
    // Path to ref genome and indexed results
    ref_path = "$baseDir/path/to/reference"

    // Define the binsizes for copy-number calling
    binsizes = ['50kb', '500kb']
    runqdnaseq = false

    // WX PARAMS
    runwisex = true
    // Create new references?
    wx_newref = true
    // Create new references from BAMs?
    wx_newref_frombam = false
    // Bins sizes
    wx_bins = [5, 15, 30, 50, 100]
    // Existing references
    wx_refs = "$baseDir/test_data/ref/npz/refs"
    // npz files for normal samples
    wx_normals = "$baseDir/test_data/ref/npz/normals"
    // bam files for normal samples
    wx_nbams = "$baseDir/test_data/ref/bams"

    outdir = "$baseDir/results"
    binannos = "$baseDir/data/1000genomes_PE150_bin_annotations"
    nthreads = 8
    aligner = 'bwamem2'

    multiqc_config = "$baseDir/multiqc_config.yaml"
}

process {
    withName:DOWNLOAD_HG38 {
        container = 'docker://curlimages/curl:latest'
        shell = ['/bin/sh']
    }
    withName: 'FASTQC.*' {
        container = 'docker://staphb/fastqc:latest'
    }
    withName: 'MULTIQC.*' {
        container = 'docker://quay.io/biocontainers/multiqc:1.3--py35_2'
    }
    withName: 'TRIMMOMATIC.*' {
        container = 'docker://staphb/trimmomatic:latest'
    }
    withName: '.*BWA.*' {
        container = 'docker://clinicalgenomics/bwa-mem2:2.2.1'
    }
    withName:MINIMAP2_ALIGNMENT {
        container = 'docker://niemasd/minimap2_samtools:latest'
    }
    withName: 'SORT_INDEX.*' {
        container = 'docker://staphb/samtools:1.19'
    }
    withName: 'MARKDUP.*' {
        container = 'docker://broadinstitute/picard:latest'
    }
    withName: 'INDCOVFLAG.*' {
        container = 'docker://staphb/samtools:1.19'
    }
    withName:CN_QDNA1 {
        container = 'docker://asntech/qdnaseq:v1.26.0'
    }
    withName: '.*WX.*' {
        container = 'docker://sofvdvel/wisecondorx:0.1'
    }
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = "$baseDir/../singularity"
    // ensure that no user libraries get mounted into the container
    process.containerOptions = "--no-home"
}