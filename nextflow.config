process {
    if (params.use_slurm) {
        executor = 'slurm'
        queue = 'upgrade'
    }

    withName: AZURE_DOWNLOAD {
        container = 'huntsmanlab/azure_download:latest'
        cpus = 1
        memory = '8 GB'
        time = '2h'
    }
    withName: DOWNLOAD_HG38 {
        container = 'docker://curlimages/curl:latest'
        shell = ['/bin/sh']
        cpus = 1
        memory = '8 GB'
        time = '1h'
    }
    withName: 'FASTQC.*' {
        container = 'docker://staphb/fastqc:latest'
        cpus = 1
        memory = '8 GB'
        time = '4h'
    }
    withName: 'MULTIQC.*' {
        container = 'docker://quay.io/biocontainers/multiqc:1.3--py35_2'
        cpus = 1
        memory = '8 GB'
        time = '1h'
    }
    withName: 'TRIMMOMATIC.*' {
        container = 'docker://staphb/trimmomatic:latest'
        cpus = 8
        memory = '32 GB'
        time = '10h'
    }
    withName: '.*BWA.*' {
        container = 'docker://clinicalgenomics/bwa-mem2:2.2.1'
        cpus = 16
        memory = '40 GB'
        time = '18h'
    }
    withName: MINIMAP2_ALIGNMENT {
        container = 'docker://niemasd/minimap2_samtools:latest'
        cpus = 32
        memory = '128 GB'
        time = '12h'
    }
    withName: 'SORT_INDEX.*' {
        container = 'docker://staphb/samtools:1.19'
        cpus = 8
        memory = '32 GB'
        time = '16h'
    }
    withName: 'MARKDUP.*' {
        container = 'docker://broadinstitute/picard:latest'
        cpus = 1
        memory = '16 GB'
        time = '12h'
    }
    withName: 'INDCOVFLAG.*' {
        container = 'docker://staphb/samtools:1.19'
        cpus = 8
        memory = '16 GB'
        time = '12h'
    }
    withName: CN_QDNA1 {
        container = 'docker://huntsmanlab/qdnaseq:latest'
        cpus = 16
        memory = '32 GB'
        time = '12h'
    }
    withName: '.*WX.*' {
        container = 'docker://sofvdvel/wisecondorx:0.1'
        cpus = 16
        memory = '32 GB'
        time = '12h'
    }
    withName: 'RCN_TO_ACN.*' {
        container = 'docker://huntsmanlab/utanos:latest'
        cpus = 8
        memory = '16 GB'
        time = '12h'
    }
    withName: QDNA_BINS {
        container = 'docker://huntsmanlab/qdnaseq:latest'
        cpus = 8
        memory = '16 GB'
        time = '16h'
    }
    withName: ICHOR_CNA {
	container = 'docker://huntsmanlab/ichorcna:latest'
        cpus = 8
        memory = '16 GB'
        time = '20h'
    }
    withName: PROCESS_ICHOR {
	container = 'docker://huntsmanlab/utanos:latest'
	cpus = 1
	memory = '8 GB'
	time = '2h'
    }
}

singularity {
    enabled = true
    autoMounts = true
    process.containerOptions = "--no-home"
}
